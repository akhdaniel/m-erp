# XERPIUM UI Service Environment Variables

# Base API URL for all API calls through the API gateway
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Base URL for notifications service (should be the same as API base URL)
VITE_NOTIFICATIONS_BASE_URL=http://localhost:8000/api/v1/notifications

# Service-specific API URLs (all routed through Kong API Gateway)
VITE_INVENTORY_API=http://localhost:8000/api/v1
VITE_SALES_API=http://localhost:8000/api/v1
VITE_PURCHASING_API=http://localhost:8000/api/v1
VITE_PARTNERS_API=http://localhost:8000/api/v1
VITE_USERS_API=http://localhost:8000/api/v1
VITE_COMPANY_PARTNER_API=http://localhost:8000/api/v1
VITE_MENU_ACCESS_API=http://localhost:8000/api/v1
VITE_MENU_API=http://localhost:8000/api/v1
VITE_UI_REGISTRY_API=http://localhost:8010/api/v1

# Development mode
NODE_ENV=development